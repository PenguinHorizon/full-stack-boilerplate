# Production environment (docs/deployment.md). Copy to backend/.env on the
# server, fill every CHANGE_ME, keep it out of version control (chmod 600).
# One file serves both the containers and Compose's ${...} placeholders:
#
#   docker compose --env-file backend/.env \
#     -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build

# ─── Platform ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3003
# The platform's own host. Organizations get {slug}.PLATFORM_DOMAIN; their own
# domains are added per organization. Also baked into the web build.
PLATFORM_DOMAIN=CHANGE_ME.example.com
# Public URL of the platform (staff password-reset links, email links).
APP_URL=https://CHANGE_ME.example.com
# Browsers reach the API same-origin through nginx; CORS only matters for
# other origins (tools, a split deployment).
ALLOWED_ORIGINS=https://CHANGE_ME.example.com
# Requests arrive edge → web → api on the Docker network.
TRUST_PROXY=loopback, linklocal, uniquelocal

# ─── Certificates (edge) ─────────────────────────────────────────────────
# Expiry and problem notices from the certificate authority.
ACME_EMAIL=CHANGE_ME@example.com

# ─── Authentication ──────────────────────────────────────────────────────
# 48+ random characters: `npm run jwtsecret` (in backend/). Changing it signs
# everyone out and invalidates order tracking links (ADR-022).
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=tourism-platform
JWT_AUDIENCE=tourism-platform-admin
CUSTOMER_JWT_AUDIENCE=app-storefront
CUSTOMER_REFRESH_EXPIRES_IN=30d
# HTTPS only (the edge terminates TLS). Same-origin, so lax is right.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─── Database (the `db` service) ─────────────────────────────────────────
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=tourism_platform
DATABASE_USER=rms_app
DATABASE_PASS=CHANGE_ME
DATABASE_ROOT_PASSWORD=CHANGE_ME
DATABASE_RETRY_ATTEMPTS=10
# Connections per API process (MySQL allows 151 by default).
DATABASE_POOL_SIZE=10
# Log statements slower than this (ms) as warnings; 0 or unset turns it off.
DATABASE_SLOW_QUERY_MS=500
# Loopback-only port on the server for backups and maintenance.
DATABASE_PORT_HOST=3307

# ─── Email ───────────────────────────────────────────────────────────────
# Order emails, password resets. Without SMTP_HOST mail is only logged.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=orders@CHANGE_ME.example.com

# ─── Media ───────────────────────────────────────────────────────────────
# `local` keeps images in the uploads volume (back it up); `cloudinary`
# stores them there (CLOUDINARY_* below).
MEDIA_STORAGE=local
MEDIA_MAX_IMAGE_MB=5
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── First super admin ───────────────────────────────────────────────────
# Used once by `npm run seed:prod`. In production it refuses the development
# default, these placeholders, and anything under 8 characters without upper-
# and lowercase letters and a digit. Remove the password from this file
# afterwards.
SEED_ADMIN_EMAIL=CHANGE_ME@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# ─── Backups (docs/operations.md) ────────────────────────────────────────
# Backups run on the server itself (not in a container). Key made by
# `npm run backup:keygen:prod`; root-only, never inside the backup folder.
# Keep a copy away from the server: backups can't be restored without it.
BACKUP_KEY_FILE=/etc/rms/backup.key
