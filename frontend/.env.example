# ─── API ─────────────────────────────────────────────────────────────────
# Base path of the versioned API. Relative on purpose: the browser always
# talks to the same origin, and the Vite dev server (or nginx in production)
# forwards /api and /uploads to the NestJS API (ADR-003).
VITE_API_URL=/api/v1

# Where `npm run dev` proxies /api and /uploads.
VITE_DEV_API_TARGET=http://localhost:3003

# ─── Platform ────────────────────────────────────────────────────────────
# Host of the platform itself. Any other host is treated as an organization
# storefront; `{slug}.PLATFORM_DOMAIN` maps to that organization.
# Must match PLATFORM_DOMAIN in backend/.env.
VITE_PLATFORM_DOMAIN=localhost

# Name shown by the platform directory and admin portal.
VITE_PLATFORM_NAME="Tourism Platform"

# ─── Storefront ──────────────────────────────────────────────────────────
# Optional Google Maps Embed API key. With it, branch pages embed a map;
# without it they link to directions instead (LOC-02).
VITE_GOOGLE_MAPS_EMBED_KEY=
