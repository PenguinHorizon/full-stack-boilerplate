# ─── Server ──────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ─── Authentication ──────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters; the app refuses to boot with the
# placeholder value. Generate one with:  npm run jwtsecret -- --write
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=fullstack-boilerplate
JWT_AUDIENCE=fullstack-boilerplate-client
# Storefront customer accounts (per organization). A different audience keeps
# customer tokens from ever passing as staff tokens, and the reverse.
CUSTOMER_JWT_AUDIENCE=app-storefront
CUSTOMER_REFRESH_EXPIRES_IN=30d

# ─── Refresh-token cookie ────────────────────────────────────────────────
# localhost:5173 and localhost:3003 are the SAME site (ports are ignored for
# SameSite), so `lax` + insecure works in local development. For a genuinely
# cross-domain deployment use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# ─── Database ────────────────────────────────────────────────────────────
# The schema is managed by migrations only (`npm run db:release`, or
# `npm run db:reset` for a throwaway local database). There is no
# auto-synchronisation; an old DATABASE_SYNC entry is ignored with a warning.
# All sessions run in UTC regardless of the MySQL server's time zone.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASS=password
DATABASE_NAME=tourism_platform
# Retries before the boot gives up. Kept low so a bad credential fails loudly
# instead of hanging ~30s; raise it when the database boots beside the app.
DATABASE_RETRY_ATTEMPTS=3
# Connections per API process (default 10).
# DATABASE_POOL_SIZE=10
# Log statements slower than this many ms as warnings (off when unset).
# DATABASE_SLOW_QUERY_MS=500
# `query` prints every SQL statement with its parameters. Investigation only:
# parameters include customers' personal data.
# DATABASE_LOGGING=query
# Optional Docker compose root overrides:
# DATABASE_ROOT_PASSWORD=root_password
# DATABASE_PORT_HOST=3307

# ─── Platform ────────────────────────────────────────────────────────────
# Host of the platform itself. `{slug}.PLATFORM_DOMAIN` serves that
# organization's storefront (e.g. northern-trails.localhost:5173 in development).
# Must match VITE_PLATFORM_DOMAIN in frontend/.env.
PLATFORM_DOMAIN=localhost

# ─── HTTP ────────────────────────────────────────────────────────────────
# Browsers reach the API same-origin through the Vite dev proxy / nginx, so
# CORS only matters for other origins. Comma-separated; "*" is rejected.
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the web app; staff password-reset links point to
# {APP_URL}/admin/reset-password.
APP_URL=http://localhost:5173
# Proxies allowed to report the client's address (X-Forwarded-For). Behind
# nginx/Docker use "loopback, linklocal, uniquelocal"; unset when the API is
# reached directly. Without it every client shares one rate limit. Never "true".
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ─── Email (optional) ────────────────────────────────────────────────────
# With SMTP_HOST unset, emails are logged to the console instead of sent,
# so password reset works end-to-end on a fresh clone.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=no-reply@example.com

# ─── Media library ──────────────────────────────────────────────────────
# Where new uploads are stored: `local` (UPLOAD_DIR, default backend/uploads,
# served at /uploads) or `cloudinary` (needs the CLOUDINARY_* values below).
MEDIA_STORAGE=local
# Largest accepted image in megabytes (1–20).
MEDIA_MAX_IMAGE_MB=5

# ─── Cloudinary (optional) ───────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Seeding ─────────────────────────────────────────────────────────────
# `npm run seed` refuses to run in production with the default password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
# Password of the demo team accounts (owner@northern-trails.example, …). Default
# Password123. The demo team is never created when NODE_ENV=production.
# SEED_DEMO_PASSWORD=Password123
